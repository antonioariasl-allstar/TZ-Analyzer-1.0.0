# ======== TZ Analysis - .gitignore ========
# Ignorar entornos virtuales
.venv/
env/
venv/
.env312/

# Ignorar cachés y temporales
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# Ignorar archivos temporales de usuario / sistema
.DS_Store
Thumbs.db
*.tmp

# Ignorar archivos de salida del programa
*.html
*.htm
*.kml
*.kmz
*.xlsx
*.csv
*.pdf
*.docx

# NOTA: antes se ignoraban todos los "*.txt". Cambiado para permitir añadir notas/documentación
# Si quieres añadir un TXT de auditoría o un archivo de Copilot, colócalo en `docs/` y se podrá versionar.
# Si necesitas seguir ignorando txt de salida, añade reglas específicas (p.ej. /tests/out/*.txt)

# Ignorar resultados o reportes generados
/reports/
/output/
/export/
/results/

# Ignorar configuraciones locales de IDE
.vscode/
.idea/

# Ignorar backups o duplicados manuales
*_copia*
*_backup*
