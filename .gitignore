# ======== TZ Analysis — .gitignore ========

# Entornos virtuales
.venv/
.venv*/
.venv312/
venv/
venv*/
env/
env*/

# Caches y artefactos Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
dist/
build/
*.spec
# TZ_Analyzer.spec sí se versiona (P1-BUILD-CONFIG): es la configuración
# reproducible del build PyInstaller ONEDIR, no un artefacto generado.
!/TZ_Analyzer.spec

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~

# Herramientas / pruebas
.pytest_cache/
.mypy_cache/
.coverage
.tox/
.nox/

# Notebooks y cachés
.ipynb_checkpoints/
.cache/

# IDEs / editor
.vscode/
.idea/

# SO
.DS_Store
Thumbs.db

# Salidas del programa (ajusta a tus rutas reales)
# Evita ignorar extensiones globales; ignora carpetas de salida.
reportes/
reports/
output/
outputs/
export/
exports/
results/
renders/
tmp/
temp/
logs/

# Backups o duplicados manuales
*_copia*
*_backup*
tests/config.json

.claude/
